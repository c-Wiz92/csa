# ============================================================
# CSA1 — Assistive Vision System
# Python (PyTorch / OpenCV / YOLOv8-face / SFace ONNX / MediaPipe)
# ============================================================

# ---------- Python bytecode / caches ----------
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test, coverage and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/

# Virtual environments (README: python -m venv venv)
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# ---------- Model weights & ML artifacts (downloaded, not tracked) ----------
# README: models/ contains downloaded model weights (not in git).
# Keep the folder itself via the checked-in models/.gitkeep.
models/*
!models/.gitkeep

# Catch any stray weight files downloaded to the repo root or elsewhere
# (YOLOv8 / SFace / MediaPipe / boxmot artifacts)
*.pt
*.pth
*.onnx
*.engine
*.task
*.tflite
*.h5

# ---------- Downloaded datasets ----------
# Fetched by scripts/evaluate_face_recognition.py (scikit-learn Olivetti)
data/olivetti/
validation_data/olivetti/

# ---------- Generated outputs / logs ----------
results/
runs/          # ultralytics default output dir
outputs/
logs/
*.log
after_results.txt
eval_results.txt
results_after.txt

# ---------- Environment / secrets ----------
.env
.env.*
*.env

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS (Windows primary) ----------
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
.DS_Store
